<h1 class="sr-only">Welcome to Coops Adventure Club</h1>

{# <div class="ticket-list">
  {% for event in collections.eventsByDate %}
    {% include "components/ticket2.njk" %}
  {% endfor %}
</div> #}


{% for group in collections.eventsByDate %}
  <details class="wdc-details" open>
    <summary>
      <div class="year-info">
        <h2 class="event-year">{{ group.year }}</h2>
        <span class="sr-only"> - </span>
        <span class="event-count">
          <img class="ticket-icon" src="/images/icons/ticket-ico.png" alt="">
          {{ group.events | length }}
          {% if group.events | length == 1 %}
            adventure
          {% else %}
            adventures
          {% endif %}
        </span>
      </div>
    </summary>

    <div class="article-container">
      {% for event in group.events %}
        {% include "components/ticket2.njk" %}
      {% endfor %}
    </div>
  </details>

{% endfor %}