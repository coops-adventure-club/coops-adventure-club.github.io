---
layout: layouts/base.njk
---

<article class="event">
  {% eventImage page.fileSlug, "hero" %}

  {% if image %}
    <img
      src="{{ image }}"
      alt=""
      class="event__image"
    >
  {% endif %}
  
  <p>
    <a href="/">← Back to all events</a>
  </p>

  
  <p class="event__category">{{ type }}</p>
  <h1>{{ title }}</h1>

  <dl class="event__details">
    <div>
      <dt>Date</dt>
      <dd>
        <time datetime="{{ date | dateToISO }}">
          {{ date | readableDate }}
        </time>
      </dd>
    </div>

    {% if location %}
      <div>
        <dt>Location</dt>
        <dd>{{ location }}</dd>
      </div>
    {% endif %}
  </dl>

   <div class="event__notes">
    {{ content | safe }}
    </div>
</article>