<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% if title %}{{ title }} | {% endif %}Stubbook
    </title>
    <link rel="stylesheet" href="/css/styles.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,100..700;1,100..700&family=Oswald:wght@200..700&display=swap" rel="stylesheet">
  </head>

  <body>
    <a id="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
      <a class="header-link" href="/">
        <img src="/images/header.png" class="header-img" alt="Adventure club logo">
        <span class="header-text">Adventure Club</span>
      </a>
    </header>

    <main id="main-content">
      {{ content | safe }}
    </main>
  </body>
</html>